Imports System.IO
Friend Module DynamicFileUpdator
    Public Sub Main(args As String())
        If args.Length = 0 OrElse args.Length > 4 Then
            PrintBanner()
            Log("******* Invalid Arguments: Please refer to the below help menu *******", LogLevel.Info)
            ShowHelp()
            Return
        End If
        If Not CheckForDynamicPath() OrElse Not IsValidCommand(args) Then
            Return
        End If
        Try
            Dim command As String = args(0).ToLower()
            Select Case command
                Case "addtype"
                    HandleAddType(args)
                Case "deletetype"
                    HandleDeleteType(args)
                Case "changeparameter"
                    HandleChangeParameter(args)
                Case "blockscreen"
                    UpdateBlackListedTransaction(args)
                Case "help"
                    PrintBanner()
                    ShowHelp()
                Case Else
                    Log("Unknown command. Use 'help' to see available commands.", LogLevel.Error)
            End Select
        Catch ex As FileNotFoundException
            Log($"❌ File not found: {ex.Message}", LogLevel.Error)
        Catch ex As UnauthorizedAccessException
            Log($"❌ Access denied: {ex.Message}", LogLevel.Error)
        Catch ex As Exception
            Log($"❌ An unexpected error occurred: {ex.Message}{Environment.NewLine}{ex.StackTrace}", LogLevel.Error)
        End Try
    End Sub
End Module
