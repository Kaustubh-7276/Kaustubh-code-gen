    Enum LogLevel
        Info
        Warning
        [Error]
    End Enum

    Sub Log(message As String, level As LogLevel)
        Select Case level
            Case LogLevel.Info
                Console.ForegroundColor = ConsoleColor.Cyan
            Case LogLevel.Warning
                Console.ForegroundColor = ConsoleColor.DarkYellow
            Case LogLevel.Error
                Console.ForegroundColor = ConsoleColor.Red
        End Select
        Dim prefix As String = $"[{level}] "
        Console.WriteLine(prefix & message)
        Console.ResetColor()
    End Sub
