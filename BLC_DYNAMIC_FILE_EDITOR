    ' General Method to Modify Nodes
    Sub ModifyNode(filePath As String, nodeName As String, nodeValue As String, add As Boolean)
        Try
            '(Path Manipulation)
            filePath = validate.Canonicalize(filePath)
            '(Path Manipulation)
            If Not File.Exists(filePath) Then
                Log($"File '{filePath}' does not exist.", LogLevel.Error)
                Return
            End If
            CreateBackup(filePath)
            ' Secure XML load
            Dim xmlDoc As XDocument = LoadXmlSafely(filePath)
            Dim typesNode As XElement = xmlDoc.Descendants("TYPES").FirstOrDefault()
            If typesNode Is Nothing Then
                Log("<TYPES> node not found.", LogLevel.Error)
                Return
            End If
            ' Validate node name and value
            If Not IsSafeXmlName(nodeName) Then
                Log($"Invalid node name '{nodeName}' detected.", LogLevel.Error)
                Return
            End If
            If Not IsSafeXmlValue(nodeValue) Then
                Log($"Invalid node value '{nodeValue}' detected.", LogLevel.Error)
                Return
            End If
            If add Then
                AddNode(typesNode, nodeName, nodeValue, filePath)
            Else
                DeleteNode(typesNode, nodeName, nodeValue, filePath)
            End If
        Catch ex As Exception
            Log($"Error modifying node: {ex.Message}", LogLevel.Error)
        End Try
    End Sub

    ' Add a Node
    Sub AddNode(parentNode As XElement, nodeName As String, nodeValue As String, filePath As String)
        '(Path Manipulation)
        filePath = validate.Canonicalize(Path.GetFullPath(filePath))
        '(Path Manipulation)
        Dim existingNode = parentNode.Elements(nodeName).FirstOrDefault(Function(e) e.Value = nodeValue)
        If existingNode IsNot Nothing Then
            Log($"{nodeName} '{nodeValue}' already exists.", LogLevel.Warning)
        Else
            parentNode.Add(New XElement(nodeName, nodeValue))
            SaveXmlDocument(parentNode.Document, filePath)
            Log($"{nodeName} '{nodeValue}' added successfully.", LogLevel.Info)
        End If
    End Sub

    ' Delete a Node
    Sub DeleteNode(parentNode As XElement, nodeName As String, nodeValue As String, filePath As String)
        '(Path Manipulation)
        filePath = validate.Canonicalize(Path.GetFullPath(filePath))
        '(Path Manipulation)
        Dim existingNode = parentNode.Elements(nodeName).FirstOrDefault(Function(e) e.Value = nodeValue)
        If existingNode Is Nothing Then
            Log($"{nodeName} '{nodeValue}' not found.", LogLevel.Warning)
        Else
            existingNode.Remove()
            SaveXmlDocument(parentNode.Document, filePath)
            Log($"{nodeName} '{nodeValue}' deleted successfully.", LogLevel.Info)
        End If
    End Sub

    ' Change Parameter Values in Files
    Sub ChangeParameter(fileName As String, dynamic_Path As String, parameterName As String, parameterValue As String)
        Try
            '(Path Manipulation: Base Path Overwriting)

            dynamic_Path = validate.Canonicalize(dynamic_Path)
            fileName = validate.Canonicalize(fileName)
            Dim filePath = validate.Canonicalize(Path.Combine(dynamic_Path, fileName))

            If Not filePath.StartsWith(dynamic_Path, StringComparison.OrdinalIgnoreCase) Then
                Throw New UnauthorizedAccessException("Invalid file path attempt detected.")
                Return
            End If

            '(Path Manipulation: Base Path Overwriting)

            '(Path Manipulation)
            Dim canonicalFullPath As String = validate.Canonicalize(Path.GetFullPath(filePath))
            '(Path Manipulation)

            If Not IsValidPath(canonicalFullPath, dynamic_Path) Then
                Log("Invalid File Name or Path Manipulation detected.", LogLevel.Error)
                Return
            End If

            If Not File.Exists(filePath) Then
                Log($"File '{filePath}' does not exist.", LogLevel.Error)
                Return
            End If

            CreateBackup(filePath)

            Dim xmlDoc As XDocument = LoadXmlSafely(filePath)
            If xmlDoc IsNot Nothing Then
                ' Validate parameter
                If Not IsSafeXmlName(parameterName) Then
                    Log($"Invalid parameter name '{parameterName}' detected.", LogLevel.Error)
                    Return
                End If

                If Not IsSafeXmlValue(parameterValue) Then
                    Log($"Invalid parameter value '{parameterValue}' detected.", LogLevel.Error)
                    Return
                End If

                Dim parameterNode As XElement = xmlDoc.Descendants(parameterName).FirstOrDefault()
                If parameterNode Is Nothing Then
                    Log($"Parameter '{parameterName}' not found.", LogLevel.Warning)
                Else
                    If parameterNode.Value <> parameterValue Then
                        parameterNode.Value = parameterValue

                        SaveXmlDocument(xmlDoc, filePath)
                        Log($"Parameter '{parameterName}' updated successfully.", LogLevel.Info)
                    Else
                        Log($"Entered value '{parameterValue}' of node '{parameterName}' which is being passed as parameter_value for entered file should not be same as existing node's value.", LogLevel.Error)
                    End If

                End If
            End If
        Catch ex As Exception
            Log($"Error changing parameter: {ex.Message}", LogLevel.Error)
        End Try
    End Sub
    Sub UpdateBlackListedTransaction(args As String())
        Try
            Dim targetPath As String = validate.Canonicalize(Path.Combine(DynamicPath, RestrictedFileName))
            Dim nTranNo As Int32
            If Not targetPath.StartsWith(DynamicPath, StringComparison.OrdinalIgnoreCase) Then
                Throw New UnauthorizedAccessException("Invalid file path attempt detected.")
                Return
            End If
            RequestedOperation = SanitizeInput(args(1).ToLower())
            RequestedTran = SanitizeInput(args(2))
            CreateBackup(targetPath)
            ' Secure XML load
            Dim xmlDoc As XDocument = LoadXmlSafely(targetPath)
            Dim typesNode As XElement = xmlDoc.Descendants("Screens").FirstOrDefault()
            If typesNode Is Nothing Then
                Log("<Screens> node not found.", LogLevel.Error)
                Return
            End If
            ' Validate node name and value
            If Not IsSafeXmlName(ReaquestedFileNode) Then
                Log($"Invalid node name '{ReaquestedFileNode}' detected.", LogLevel.Error)
                Return
            End If
            If Not IsSafeXmlValue(RequestedTran) Then
                Log($"Invalid node value '{RequestedTran}' detected.", LogLevel.Error)
                Return
            End If
            Try
                nTranNo = Int32.Parse(RequestedTran)
                PaddedTranNo = nTranNo.ToString().PadLeft(6, "0"c)
                TranType = True
            Catch ex As Exception
                TranType = False
            End Try
            Select Case RequestedOperation
                Case "add"
                    If TranType Then
                        Dim addingNode = typesNode.Elements(ReaquestedFileNode).FirstOrDefault(Function(e) e.Value = PaddedTranNo)
                        If addingNode IsNot Nothing Then
                            Log($"{ReaquestedFileNode} '{PaddedTranNo}' already exists.", LogLevel.Warning)
                        Else
                            typesNode.Add(New XElement(ReaquestedFileNode, PaddedTranNo))
                            SaveXmlDocument(typesNode.Document, targetPath)
                            Log($"{ReaquestedFileNode} '{PaddedTranNo}' added successfully.", LogLevel.Info)
                        End If
                    Else
                        Dim addingNode = typesNode.Elements(ReaquestedFileNode).FirstOrDefault(Function(e) e.Value = RequestedTran)
                        If addingNode IsNot Nothing Then
                            Log($"{ReaquestedFileNode} '{RequestedTran}' already exists.", LogLevel.Warning)
                        Else
                            typesNode.Add(New XElement(ReaquestedFileNode, RequestedTran))
                            SaveXmlDocument(typesNode.Document, targetPath)
                            Log($"{ReaquestedFileNode} '{RequestedTran}' added successfully.", LogLevel.Info)
                        End If
                    End If

                Case "delete"
                    If TranType Then
                        Dim nodetobeDeleted = typesNode.Elements(ReaquestedFileNode).FirstOrDefault(Function(e) e.Value = PaddedTranNo)
                        If nodetobeDeleted Is Nothing Then
                            Log($"{ReaquestedFileNode} '{PaddedTranNo}' not found.", LogLevel.Warning)
                        Else
                            nodetobeDeleted.Remove()
                            SaveXmlDocument(typesNode.Document, targetPath)
                            Log($"{ReaquestedFileNode} '{PaddedTranNo}' deleted successfully.", LogLevel.Info)
                        End If
                    Else
                        Dim nodetobeDeleted = typesNode.Elements(ReaquestedFileNode).FirstOrDefault(Function(e) e.Value = RequestedTran)
                        If nodetobeDeleted Is Nothing Then
                            Log($"{ReaquestedFileNode} '{RequestedTran}' not found.", LogLevel.Warning)
                        Else
                            nodetobeDeleted.Remove()
                            SaveXmlDocument(typesNode.Document, targetPath)
                            Log($"{ReaquestedFileNode} '{RequestedTran}' deleted successfully.", LogLevel.Info)
                        End If
                    End If

                Case Else
                    Log($"Invalid File Operation Opted", LogLevel.Error)
                    Return
            End Select

        Catch ex As FileNotFoundException
            Log($"❌ File not found: {ex.Message}", LogLevel.Error)
            Return
        Catch ex As UnauthorizedAccessException
            Log($"❌ Access denied: {ex.Message}", LogLevel.Error)
            Return
        Catch ex As NullReferenceException
            Log($"❌ Null-Point Exception found: {ex.Message}", LogLevel.Error)
            Return
        Catch ex As Exception
            Log($"❌ Exception occured : {ex.Message}", LogLevel.Error)
            Return

        End Try
    End Sub

    'Storing DropDownValues for 67050,7050,69004
    Function CaptureDropDownValues(tranNo As String, dropdownValue As String, Optional basePath As String = "") As Boolean
        Try
            Try
                If basePath <> "" AndAlso Not DropDownPath.StartsWith(Path.GetFullPath(basePath), StringComparison.Ordinal) Then
                    Log("Access prevented: file outside allowed directory.", LogLevel.Error)
                    Return False
                End If
            Catch ex As FileNotFoundException
                Log($"❌ File not found: {ex.Message}", LogLevel.Error)
                Return False
            Catch ex As UnauthorizedAccessException
                Log($"❌ Access denied: {ex.Message}", LogLevel.Error)
                Return False
            Catch ex As NullReferenceException
                Log($"❌ Null-Point Exception found: {ex.Message}", LogLevel.Error)
                Return False
            Catch ex As Exception
                Log($"Error while capturing dynamic path for comparing values for {tranNo}: " & ex.Message, LogLevel.Error)
                Return False
            End Try
            Try
                ' Determine file based on tranNo
                Dim targetPath As String = ""
                Dim fileName As String = ""
                Select Case tranNo
                    Case "67050"
                        '(Path Manipulation)
                        fileName = validate.Canonicalize("optcode1.htm")
                        targetPath = validate.Canonicalize(Path.GetFullPath(Path.Combine(DropDownPath, fileName)))
                        If Not targetPath.StartsWith(DropDownPath, StringComparison.OrdinalIgnoreCase) Then
                            Throw New UnauthorizedAccessException($"Invalid file path attempt detected for '{tranNo}', please contact system administrator")
                            Return False
                        End If
                        '(Path Manipulation)
                    Case "7050"
                        '(Path Manipulation)
                        fileName = validate.Canonicalize("optcode4.htm")
                        targetPath = validate.Canonicalize(Path.GetFullPath(Path.Combine(DropDownPath, fileName)))
                        If Not targetPath.StartsWith(DropDownPath, StringComparison.OrdinalIgnoreCase) Then
                            Throw New UnauthorizedAccessException($"Invalid file path attempt detected for '{tranNo}', please contact system administrator")
                            Return False
                        End If
                        '(Path Manipulation)
                    Case "NBC_FILEUPLOAD_TYPE"
                        '(Path Manipulation)
                        fileName = validate.Canonicalize("uploadTypeNew.htm")
                        targetPath = validate.Canonicalize(Path.GetFullPath(Path.Combine(DropDownPath, fileName)))
                        If Not targetPath.StartsWith(DropDownPath, StringComparison.OrdinalIgnoreCase) Then
                            Throw New UnauthorizedAccessException($"Invalid file path attempt detected for '{tranNo}', please contact system administrator")
                            Return False
                        End If
                        '(Path Manipulation)
                    Case "NBC_ACCOUNT_INSURANCE_TYPE"
                        '(Path Manipulation)
                        fileName = validate.Canonicalize("system2.htm")
                        targetPath = validate.Canonicalize(Path.GetFullPath(Path.Combine(DropDownPath, fileName)))
                        If Not targetPath.StartsWith(DropDownPath, StringComparison.OrdinalIgnoreCase) Then
                            Throw New UnauthorizedAccessException($"Invalid file path attempt detected for '{tranNo}', please contact system administrator")
                            Return False
                        End If
                        '(Path Manipulation)
                    Case Else
                        Log("Invalid transaction number.", LogLevel.Error)
                        Return False
                End Select

                ' Check if file exists
                If Not File.Exists(targetPath) Then
                    Log($"File for entered tran_no '{tranNo}' does not exist, Please contact system administrator", LogLevel.Error)
                    Return False
                End If

                ' Read file as plain text
                Dim fileContent As String = File.ReadAllText(targetPath)

                ' Use regex to safely extract all OPTION values (case-insensitive tag, but capture raw value)
                Dim optionRegex As New Text.RegularExpressions.Regex("(?i)<option\s+[^>]*\bvalue\s*=\s*""([^""]*)""")
                Dim matches = optionRegex.Matches(fileContent)

                Dim optionValues As New HashSet(Of String)()
                For Each m As Text.RegularExpressions.Match In matches
                    ' DO NOT trim or lowercase -> strict match required
                    optionValues.Add(m.Groups(1).Value)
                Next

                ' Strict match: case + whitespace must be exact
                If optionValues.Contains(dropdownValue) Then
                    Return True
                Else
                    Log($"Argument value '{dropdownValue}' not as per the option_file of '{tranNo}'.", LogLevel.Error)
                    Return False
                End If
            Catch ex As Exception
                Log($"Error while comparing argument value with existing system value for {tranNo}: " & ex.Message, LogLevel.Error)
                Return False
            End Try
        Catch ex As Exception
            Log($"Error while comparing argument value with existing system value for {tranNo}: " & ex.Message, LogLevel.Error)
            Return False
        End Try
    End Function
    Function CheckForDynamicPath() As Boolean
        Try
            DynamicPath = validate.Canonicalize(Path.GetFullPath(Path.Combine(System.AppDomain.CurrentDomain.BaseDirectory & ".." & Path.DirectorySeparatorChar & "xml" & Path.DirectorySeparatorChar & "Settings")))
            CheckPathDirectory(DynamicPath)
            DirectoryPath = validate.Canonicalize(Path.GetFullPath(Path.Combine(System.AppDomain.CurrentDomain.BaseDirectory & ".." & Path.DirectorySeparatorChar & "html")))
            CheckPathDirectory(DirectoryPath)
            BasePath = validate.Canonicalize(Path.GetFullPath(Path.Combine(System.AppDomain.CurrentDomain.BaseDirectory & ".." & Path.DirectorySeparatorChar)))
            CheckPathDirectory(BasePath)
            DropDownPath = validate.Canonicalize(Path.GetFullPath(Path.Combine(AppDomain.CurrentDomain.BaseDirectory & ".." & Path.DirectorySeparatorChar & "html" & Path.DirectorySeparatorChar & "DropDownLists")))
            CheckPathDirectory(DropDownPath)
            Return True
        Catch ex As FileNotFoundException
            Log($"❌ File not found: {ex.Message}", LogLevel.Error)
            Return False
        Catch ex As UnauthorizedAccessException
            Log($"❌ Access denied: {ex.Message}", LogLevel.Error)
            Return False
        Catch ex As NullReferenceException
            Log($"❌ Null-Point Exception found: {ex.Message}", LogLevel.Error)
            Return False
        Catch ex As Exception
            Log($"❌ An unexpected error occurred: {ex.Message}{Environment.NewLine}{ex.StackTrace}", LogLevel.Error)
            Return False
        End Try
        Return True
    End Function
