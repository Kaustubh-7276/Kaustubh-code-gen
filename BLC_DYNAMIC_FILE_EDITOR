Module FileOperation
    'Checking if directory is Created Or Not
    Public Sub CheckPathDirectory(pathToCreate As String)
        If Not Directory.Exists(pathToCreate) Then
            Log($"❌ Direcotry not found, started creating directory: '{pathToCreate}'", LogLevel.Info)
            Directory.CreateDirectory(pathToCreate)
        End If
    End Sub
    Sub CreateBackup(filePath As String, Optional basePath As String = "")
        Try
            '(Path Manipulation)
            filePath = validate.Canonicalize(filePath)
            '(Path Manipulation)

            If basePath <> "" AndAlso Not filePath.StartsWith(Path.GetFullPath(basePath), StringComparison.OrdinalIgnoreCase) Then
                Log("Backup prevented: file outside allowed directory.", LogLevel.Error)
                Return
            End If
            '(Path Manipulation)
            Dim backupPath As String = validate.Canonicalize(Path.GetFullPath(Path.Combine(filePath & ".bak")))
            '(Path Manipulation)

            If File.Exists(backupPath) Then File.Delete(backupPath)
            File.Copy(filePath, backupPath, True)
            Log("Backup created successfully.", LogLevel.Info)

        Catch ex As FileNotFoundException
            Log($"❌ File not found: {ex.Message}", LogLevel.Error)
        Catch ex As UnauthorizedAccessException
            Log($"❌ Access denied: {ex.Message}", LogLevel.Error)
        Catch ex As NullReferenceException
            Log($"❌ Null-Point Exception found: {ex.Message}", LogLevel.Error)
        Catch ex As Exception
            Log($"Error creating backup with exception {ex.Message}", LogLevel.Error)
        End Try

    End Sub
    Sub SaveXmlDocument(xmlDoc As XDocument, filePath As String, Optional basePath As String = "")
        Try
            '(Path Manipulation)
            filePath = validate.Canonicalize(filePath)
            '(Path Manipulation)

            If basePath <> "" AndAlso Not filePath.StartsWith(Path.GetFullPath(basePath), StringComparison.OrdinalIgnoreCase) Then
                Log("Save prevented: file outside allowed directory.", LogLevel.Error)
                Return
            End If

            '(Path Manipulation)
            Dim tempFile As String = validate.Canonicalize(Path.GetFullPath(Path.Combine(filePath & ".tmp")))
            '(Path Manipulation)
            tempFile = validate.Canonicalize(tempFile)

            ' Force pretty-print formatting
            Dim settings As New Xml.XmlWriterSettings With {
            .Indent = True,
            .IndentChars = "  ",   ' 2 spaces
            .NewLineChars = vbCrLf,
            .NewLineHandling = Xml.NewLineHandling.Replace,
            .Encoding = System.Text.Encoding.UTF8,
            .CloseOutput = True
            }

            Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(tempFile, settings)
                Dim formatted As XDocument = XDocument.Parse(xmlDoc.ToString(SaveOptions.None))
                formatted.Save(writer)
            End Using

            If File.Exists(filePath) Then File.Delete(filePath)
            File.Move(tempFile, filePath)

            Log("Document saved successfully.", LogLevel.Info)

        Catch ex As Exception
            Log($"Error saving XML document: {ex.Message}", LogLevel.Error)
        End Try
    End Sub

    'To check XML Injection
    Function LoadXmlSafely(filePath As String) As XDocument
        '(Path Manipulation)
        filePath = validate.Canonicalize(Path.GetFullPath(filePath))
        '(Path Manipulation)
        Try
            Dim goodSettingsws As New XmlReaderSettings With {
                .DtdProcessing = DtdProcessing.Ignore,
                .XmlResolver = Nothing,
                .ValidationType = ValidationType.Schema,
                .Schemas = New System.Xml.Schema.XmlSchemaSet(),
                .MaxCharactersFromEntities = 1024,
                .IgnoreComments = True
            }
            Using goodxmlreadws As XmlReader = XmlReader.Create(filePath, goodSettingsws)
                Dim xmlDoc As XDocument = XDocument.Load(goodxmlreadws)
                goodxmlreadws.Close()
                Return xmlDoc
            End Using
        Catch ex As Exception
            Log($"Error loading XML safely: {ex.Message}", LogLevel.Error)
            Return Nothing
        End Try
    End Function

    ' ===== Validate XML Node Name =====
    Function IsSafeXmlName(name As String) As Boolean
        '(Path Manipulation)
        name = validate.Canonicalize(Path.GetFileName(name))
        '(Path Manipulation)
        Return Not String.IsNullOrWhiteSpace(name) AndAlso XmlConvert.VerifyName(name) IsNot Nothing
    End Function

    ' ===== Validate XML Node Value =====
    Function IsSafeXmlValue(value As String) As Boolean
        ' Reject control characters that can break XML
        Return value IsNot Nothing AndAlso Not Regex.IsMatch(value, "[\x00-\x08\x0B\x0C\x0E-\x1F]")
    End Function

    Function IsValidPath(canonicalPath As String, basePath As String) As Boolean
        Return canonicalPath.StartsWith(basePath, StringComparison.OrdinalIgnoreCase) AndAlso
           canonicalPath.Equals(Path.GetFullPath(canonicalPath), StringComparison.OrdinalIgnoreCase)
    End Function
    ' Handle Adding a Type Node
    Sub HandleAddType(args As String())
        If args.Length = 3 Then
            Dim tranNo As String = args(1)
            Dim typeValue As String = SanitizeInput(args(2))
            If tranNo = "NBC_FILEUPLOAD_TYPE" Then
                If CaptureDropDownValues(tranNo, typeValue) Then
                    ModifyFileTypeNode(tranNo, typeValue, add:=True)
                Else
                    Log($"Invalid arguments for addtype command, for dyanmic file {tranNo} provided <FILETYPE> '{typeValue}' is not valid.", LogLevel.Error)
                    Return
                End If
            ElseIf (tranNo = "67050" Or tranNo = "7050") Then
                If CaptureDropDownValues(tranNo, typeValue) Then
                    ModifyTypeNode(tranNo, typeValue, add:=True)
                Else
                    Log($"Invalid arguments for addtype command, for dyanmic file {tranNo} provided <TYPE> '{typeValue}' is not valid.", LogLevel.Error)
                    Return
                End If
            Else
                If CaptureDropDownValues(tranNo, typeValue) Then
                    ModifyTypeNodeother(tranNo, typeValue, add:=True)
                Else
                    Log($"Invalid arguments for addtype command, for dyanmic file {tranNo} provided <TYPE> '{typeValue}' is not valid.", LogLevel.Error)
                    Return
                End If
            End If
        Else
            Log("Invalid arguments for addtype command.", LogLevel.Error)
        End If
    End Sub

    ' Handle Deleting a Type Node
    Sub HandleDeleteType(args As String())
        If args.Length = 3 Then
            Dim tranNo As String = args(1)
            Dim typeValue As String = SanitizeInput(args(2))
            If tranNo = "NBC_FILEUPLOAD_TYPE" Then
                ModifyFileTypeNode(tranNo, typeValue, add:=False)
            ElseIf (tranNo = "67050" OrElse tranNo = "7050") Then
                ModifyTypeNode(tranNo, typeValue, add:=False)
            Else
                ModifyTypeNodeother(tranNo, typeValue, add:=False)
            End If
        Else
            Log("Invalid arguments for deletetype command.", LogLevel.Error)
        End If
    End Sub

    ' Handle Changing Parameters in Specific Files
    Sub HandleChangeParameter(args As String())
        '(Path Manipulation)
        Dim fileName As String = validate.Canonicalize(Path.GetFileName(args(1)))
        '(Path Manipulation)
        Dim parameterName As String = SanitizeInput(args(2))
        Dim parameterValue As String = SanitizeInput(args(3))
        If fileName = "timeout.Config" OrElse fileName = "timegap.Config" Then
            ChangeParameter(fileName, BasePath, parameterName, parameterValue)
        Else
            ChangeParameter(fileName, DynamicPath, parameterName, parameterValue)
        End If
    End Sub

    ' Modify <TYPE> Nodes for Files like 67050 and 7050
    Sub ModifyTypeNode(tranNo As String, typeValue As String, add As Boolean)
        Dim filePath As String
        Dim canonicalFullPath As String
        Dim fileName As String = validate.Canonicalize(tranNo & "_Option.xml")
        Dim targetPath As String = validate.Canonicalize(Path.Combine(DynamicPath, fileName))

        If Not targetPath.StartsWith(DynamicPath, StringComparison.OrdinalIgnoreCase) Then
            Throw New UnauthorizedAccessException("Invalid file path attempt detected.")
            Return
        End If
        '(Path Manipulation: Base Path Overwriting)

        Try
            '(Path Manipulation: Base Path Overwriting)
            filePath = validate.Canonicalize(Path.GetFullPath(targetPath))
            '(Path Manipulation: Base Path Overwriting)

            '(Path Manipulation)
            canonicalFullPath = validate.Canonicalize(Path.GetFullPath(filePath))
            '(Path Manipulation)

            If Not IsValidPath(canonicalFullPath, DynamicPath) Then
                Log("Invalid File Name or Path Manipulation detected.", LogLevel.Error)
                Return
            End If
        Catch ex As FileNotFoundException
            Log($"❌ File not found: {ex.Message}", LogLevel.Error)
            Return
        Catch ex As UnauthorizedAccessException
            Log($"❌ Access denied: {ex.Message}", LogLevel.Error)
            Return
        Catch ex As NullReferenceException
            Log($"❌ Null-Point Exception found: {ex.Message}", LogLevel.Error)
            Return
        Catch ex As Exception
            Log($"❌ Exception occured : {ex.Message}", LogLevel.Error)
            Return
        End Try
        '(Checking escape characters)
        typeValue = SanitizeInput(typeValue)
        '(Checking escape characters)
        ModifyNode(filePath, "TYPE", typeValue, add)
    End Sub

    ' Modify <TYPE> Nodes for Files other than 67050 and 7050
    Sub ModifyTypeNodeother(tranNo As String, typeValue As String, add As Boolean)
