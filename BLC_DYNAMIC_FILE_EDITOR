Module BLCValidation
    Public Function IsValidCommand(args As String()) As Boolean
        Try
            For Each argument As String In args
                For Each restricted As String In RistrictedArguments
                    If argument.Contains(restricted) Then
                        Log($"Arguments '{String.Join(" ", args)}' Contains restricted argument type i.e. '{restricted}' ", LogLevel.Error)
                        Return False
                    End If
                Next
                For Each characs As String In RestrictedCharSet
                    If argument.Contains(characs) Then
                        Log($"Arguments '{String.Join(" ", args)}' Contains restricted argument type i.e. '{characs}' ", LogLevel.Error)
                        Return False
                    End If
                Next
            Next

            For Each argumentNew As String In args
                ' Reject if contains slashes or backslashes
                If argumentNew.Contains("/") OrElse argumentNew.Contains("\") Then
                    Log($"Argument '{argumentNew}' should not contain '/' or '\'.", LogLevel.Error)
                    Return False
                End If

                ' Reject if contains path traversal
                If argumentNew.Contains("..") Then
                    Log($"Argument '{argumentNew}' should not contain '..'.", LogLevel.Error)
                    Return False
                End If

                ' Reject if argument matches reserved device name (without extension)
                Dim nameWithoutExtension As String = argumentNew ' you don't expect extensions anyway
                If ReverseNames.Any(Function(rn) String.Equals(rn, nameWithoutExtension, StringComparison.OrdinalIgnoreCase)) Then
                    Log($"Argument '{argumentNew}' is a reserved device name.", LogLevel.Error)
                    Return False
                End If

                ' Reject if contains invalid filename characters
                Dim invalidChars As Char() = System.IO.Path.GetInvalidFileNameChars()
                If argumentNew.IndexOfAny(invalidChars) >= 0 Then
                    Log($"Argument '{argumentNew}' contains invalid characters.", LogLevel.Error)
                    Return False
                End If

                ' Reject if too long
                If argumentNew.Length > 255 Then
                    Log($"Argument '{argumentNew}' is too long.", LogLevel.Error)
                    Return False
                End If
            Next

            ' Get the command name from args(0)
            OperationMethod = SanitizeInput(args(0))
            Try
                TranToExecute = SanitizeInput(args(1))
            Catch ex As Exception
                TranToExecute = ""
            End Try

            ' Check if the command is in the allowed list
            If Not AllowedCommands.Contains(OperationMethod, StringComparer.OrdinalIgnoreCase) Then
                PrintBanner()
                Log($"Unknown command: {OperationMethod}. Use 'help' to see available commands.", LogLevel.Error)
                ShowHelp()
                Return False
            End If

            ' Now check argument count based on command
            If OperationMethod.Equals("addtype", StringComparison.OrdinalIgnoreCase) Then
                ExpectedArguments = "3"
                If args.Length <> 3 Then
                    PrintBanner()
                    Log($"Invalid number of arguments for addtype. Expected '{ExpectedArguments}' arguments.", LogLevel.Error)
                    ShowHelp()
                    Return False
                End If
                If Not AllowedFileNames.Contains(TranToExecute, StringComparer.OrdinalIgnoreCase) Then
                    Log($"Unknown Transaction i.e '{TranToExecute}' for '{OperationMethod}'.Connect to Service Desk for more details or use 'help' to see available commands.", LogLevel.Error)
                    Return False
                End If
            ElseIf OperationMethod.Equals("help", StringComparison.OrdinalIgnoreCase) Then
                ExpectedArguments = "1"
                If args.Length <> 1 Then
                    PrintBanner()
                    Log("The 'help' command doesn't require extra arguments.", LogLevel.Error)
                    ShowHelp()
                    Return False
                End If
            ElseIf OperationMethod.Equals("deletetype", StringComparison.OrdinalIgnoreCase) Then
                ExpectedArguments = "3"
                If args.Length <> 3 Then
                    PrintBanner()
                    Log($"Invalid number of arguments for deletetype. Expected '{ExpectedArguments}' arguments.", LogLevel.Error)
                    ShowHelp()
                    Return False
                End If
                If Not AllowedFileNames.Contains(TranToExecute, StringComparer.OrdinalIgnoreCase) Then
                    PrintBanner()
                    Log($"Unknown Transaction i.e '{TranToExecute}' for '{OperationMethod}'. Use 'help' to see available commands.", LogLevel.Error)
                    ShowHelp()
                    Return False
                End If
            ElseIf OperationMethod.Equals("changeparameter", StringComparison.OrdinalIgnoreCase) Then
                ExpectedArguments = "4"
                If args.Length <> 4 Then
                    PrintBanner()
                    Log($"Invalid number of arguments for changeparameter. Expected '{ExpectedArguments}' arguments.", LogLevel.Error)
                    ShowHelp()
                    Return False
                End If
            ElseIf OperationMethod.Equals("blockscreen", StringComparison.OrdinalIgnoreCase) Then
                ExpectedArguments = "3"
                If args.Length <> "3" Then
                    PrintBanner()
                    Log($"Invalid number of arguments for changeparameter. Expected '{ExpectedArguments}' arguments.", LogLevel.Error)
                    ShowHelp()
                    Return False
                Else
                    ScreenOperation = SanitizeInput(args(1).ToLower)
                    TranNumber = SanitizeInput((args(2)))

                    If Not AllowedOperation.Contains(ScreenOperation, StringComparer.OrdinalIgnoreCase) Then
                        Log($"Unknown screen operation: '{ScreenOperation}' opted for operation please try with allowed operations i.e. {String.Join(",", AllowedOperation)}. Use 'help' to see available commands.", LogLevel.Error)
                        Return False
                    End If
                    Try
                        IntTranNo = Convert.ToInt32(SanitizeInput(args(2)))
                        TranNumber = IntTranNo.ToString().PadLeft(6, "0"c)
                        If ValidateTranNo(TranNumber) Then
                            Log($"You have opted for transaction no: '{TranNumber}'", LogLevel.Info)
                        Else
                            Log($"You cannot proceed for transaction no: '{TranNumber}'", LogLevel.Error)
                            Return False
                        End If
                    Catch ex As Exception
                        If SanitizeTranNo(TranNumber) Then
                            Log($"You have opted for transaction no(html): '{TranNumber}'", LogLevel.Info)
                        Else
                            Log($"You cannot proceed for transaction no(html): '{TranNumber}'", LogLevel.Error)
                            Return False
                        End If
                    End Try
                    Try
                        Dim _blcTranList As New HashSet(Of String)
                        Dim _htmlFileNames() As String = Directory.GetFiles(validate.Canonicalize(DirectoryPath))
                        For Each filePath As String In _htmlFileNames
                            Dim fileNameWithoutExtension As String = Path.GetFileNameWithoutExtension(filePath)
                            _blcTranList.Add(validate.Canonicalize(fileNameWithoutExtension))
                        Next
                        If Not _blcTranList.Contains(TranNumber) Then
                            Log($"Opted Transaction: '{TranNumber}' is not exist in CBS", LogLevel.Error)
                            Return False
                        End If
                    Catch ex As Exception
                        Log($"❌ An unexpected error occurred while validating command: {ex.Message}{Environment.NewLine}{ex.StackTrace}", LogLevel.Error)
                        Return False
                    End Try
                End If
            End If
            ' All checks passed
        Catch ex As IndexOutOfRangeException
            Log($"❌ An unexpected error occurred while validating command: {ex.Message}{Environment.NewLine}{ex.StackTrace}", LogLevel.Error)
            Return False
        Catch ex As Exception
            Log($"❌ An unexpected error occurred while validating command: {ex.Message}{Environment.NewLine}{ex.StackTrace}", LogLevel.Error)
            Return False
        End Try
        Return True
    End Function

    'To validate transaction number
    Public Function ValidateTranNo(tranNo As String) As Boolean
        Dim regexPattern As New Regex("^(?!0{6})\d{6}$")
        If regexPattern.IsMatch(tranNo) Then
            Return True
        Else
            Log($"If you opted for Numeric based transaction i.e. '{tranNo}' then it should contain only min(0) and max(6) digits and it should not contain all zeros", LogLevel.Error)
            Return False
        End If
        Return True
    End Function
    Function SanitizeTranNo(tranNo As String) As Boolean
        tranNo = SanitizeInput(tranNo)
        Dim regPattern As New Regex("^[a-zA-Z0-9]*$")
        If regPattern.IsMatch(tranNo) Then
            Return True
        Else
            Log($"If you opted for Alpha/Aplha-Numeric based transaction i.e. '{tranNo}' then it should not contain any special characters", LogLevel.Error)
            Return False
        End If
    End Function
    Function SanitizeInput(input As String) As String
        Return System.Security.SecurityElement.Escape(input)
    End Function
End Module

