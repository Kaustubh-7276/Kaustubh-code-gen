    Public Function ParseAttributeofHtml(ByVal fileLines As String) As HashSet(Of String)(StringComparer.Ordinal)
    
        Dim htmlFileData = New HashSet(Of String)(StringComparer.Ordinal)

        'Join lines into a single string if they are fragmented, or parse line by line if guaranteed complete tags
        Dim htmlContent As String = String.Join(Environment.NewLine, fileLines)
        Dim doc As New HtmlDocument()
        doc.LoadHtml(htmlContent)
         
        'Select all <option> nodes
        Dim options = doc.DocumentNode.SelectNodes("//option")
         
        If options IsNot Nothing Then
            For Each option In options
                'Get the "value" attribute directly
                Dim valueNode = option.Attributes("value")
                                
                If valueNode IsNot Nothing AndAlso Not String.IsNullOrEmpty(valueNode.Value) Then
                    htmlFileData.Add(valueNode.Value.Trim())
                End If
            Next
        End If
        Return htmlFileData
    End function    
